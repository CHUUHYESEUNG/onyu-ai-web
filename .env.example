# ===================================
# Supabase 설정
# ===================================
# Supabase 프로젝트 URL (https://supabase.com/dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Anon (공개) 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role (비밀) 키 - 절대 클라이언트에 노출하지 마세요!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===================================
# AI/STT 서비스
# ===================================
# Deepgram API 키 (https://console.deepgram.com → API Keys)
# 음성을 텍스트로 변환하는 STT 서비스
NEXT_PUBLIC_DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API 키 (https://platform.openai.com → API keys)
# 텍스트 요약 및 구조화에 사용
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ===================================
# 앱 설정 (선택사항)
# ===================================
# 앱 URL (로컬 개발: http://localhost:3000, 프로덕션: 실제 도메인)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node 환경 (development, production)
NODE_ENV=development
